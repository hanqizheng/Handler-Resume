{
  "name": "handler-resume",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:private": "RESUME_SOURCE=resume.private.md node scripts/dev.mjs",
    "dev:private:en": "RESUME_SOURCE=resume.en.private.md node scripts/dev.mjs",
    "start": "npm run dev",
    "build": "node scripts/build.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "pdf:private": "RESUME_SOURCE=resume.private.md node scripts/export-pdf.mjs",
    "pdf:private:en": "RESUME_SOURCE=resume.en.private.md node scripts/export-pdf.mjs",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf _site resume*.pdf tmp"
  }
}
